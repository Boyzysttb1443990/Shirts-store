# คัดลอกไฟล์นี้เป็นชื่อ ".env" แล้วเปลี่ยนค่า JWT_SECRET เป็นข้อความสุ่มยาวๆ ของพี่เอง
# ห้ามใช้ค่าตัวอย่างนี้ตอน deploy จริงเด็ดขาด

JWT_SECRET=change-this-to-a-long-random-secret-string
PORT=4000

# เบอร์โทรที่จะได้สิทธิ์ Admin โดยอัตโนมัติตอนสมัครสมาชิก (คั่นด้วยจุลภาค ไม่มีเว้นวรรค)
# ตัวอย่าง: ADMIN_PHONES=02012345,02099999
ADMIN_PHONES=
